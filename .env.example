# Copy to .env and fill in locally. .env is git-ignored; never commit real values.
# Hugging Face (only needed for gated repos)
HF_TOKEN=
HF_HOME=./.hf_cache
# Where large artifacts live (can point outside the repo)
OBJ_DATA_ROOT=./data
OBJ_ARTIFACT_ROOT=./artifacts
# Lean
ELAN_HOME=
LEAN_REPL_TIMEOUT_S=120
# Compute
OBJ_DEVICE=auto        # auto | cpu | mps | cuda
OBJ_NUM_WORKERS=4
