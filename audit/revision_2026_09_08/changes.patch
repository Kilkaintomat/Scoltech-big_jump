+@pytest.mark.parametrize("value", [np.nan, np.inf, -1.0])
+def test_nonfinite_or_negative_deviations_are_rejected(value):
+    df = table()
+    df.loc[0, "z"] = value
+    with pytest.raises(ValueError, match="finite and nonnegative"):
+        validate_table(df)
