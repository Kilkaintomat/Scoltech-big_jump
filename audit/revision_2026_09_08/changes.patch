+def test_incomplete_alignment_is_refused():
+    class MissingTokenizer(CharTokenizer):
+        def __call__(self, text, **kwargs):
+            result = super().__call__(text, **kwargs)
+            result["offset_mapping"] = [(0, 1)] + [(0, 0)] * (len(text) - 1)
+            return result
