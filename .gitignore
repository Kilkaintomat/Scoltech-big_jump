# --- secrets ---
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
.netrc
**/token
**/credentials.json

# --- python ---
__pycache__/
*.py[cod]
*.so
.venv/
venv/
.eggs/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- data / heavy artifacts (never committed) ---
data/raw/**
data/interim/**
data/processed/**
!data/**/.gitkeep
# Benchmark statements are ~1 MB of text and pin what was actually proved against; committing
# them is what makes a run reproducible from the repository alone.
!data/raw/*.jsonl
!data/raw/benchmarks.json
artifacts/models/**
artifacts/activations/**
artifacts/calibration/**
!artifacts/**/.gitkeep
*.safetensors
*.bin
*.ckpt
*.pt
*.pth
*.npy
*.npz
*.h5

# --- lean ---
lean_workspace/.lake/
lean_workspace/build/
lean_workspace/**/*.olean

# --- caches ---
.hf_cache/
.cache/
hf_home/
wandb/
lightning_logs/
runs/

# --- large results (small metrics/figures ARE committed, see .gitattributes) ---
results/**/*.parquet
results/**/*.arrow
results/**/raw_*
logs/
*.log

# --- os ---
.DS_Store
._*
.idea/
.vscode/

# --- source paper draft (double-blind submission; kept local, not committed) ---
docs/*.pdf

# --- Lean toolchain and cached environments (large, machine-specific) ---
lean_workspace/mathlib_project/.lake/
lean_workspace/repl/
**/.env_cache/
*.olean
lean_workspace/mathlib_project/.github/

# --- smoke-test artefacts must not sit in paper_outputs beside real results ---
paper_outputs/**/*activations-analysis*
